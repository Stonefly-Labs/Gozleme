# Local development defaults for `docker compose`. Copy to `.env` to override.
# These are throwaway local-only credentials for a disposable database; never reuse them.
GOZLEME_DB_SUPERUSER_PASSWORD=local-dev-superuser
GOZLEME_MIGRATOR_PASSWORD=local-dev-migrator
GOZLEME_APP_PASSWORD=local-dev-app

# Host port overrides
GOZLEME_WEB_PORT=3000
GOZLEME_API_PORT=8080
GOZLEME_DB_PORT=5432

# Shown in the status document and dashboard
GOZLEME_BUILD=0.1.0-local
